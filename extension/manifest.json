{
  "manifest_version": 3,
  "name": "Karaoke Queue Player",
  "version": "1.0.0",
  "description": "Plays the karaoke queue on YouTube. The /play page stays available as a fallback.",
  "permissions": ["tabs", "storage", "alarms", "windows"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Karaoke Queue",
    "default_popup": "popup.html"
  },
  "commands": {
    "next-song": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right"
      },
      "description": "Play the next song"
    },
    "prev-song": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left"
      },
      "description": "Play the previous song"
    }
  }
}
